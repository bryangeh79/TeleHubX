<!DOCTYPE html>
<!--
  TeleHubX startup splash window (vmfix18 / Issue #25).

  Spawned by telehubx-start.vbs after `sc.exe start TeleHubX`.

  - Polls http://127.0.0.1:9800/health every 2s (up to 5 min total)
  - Updates status text so the operator can see "things are happening"
    during the 2-3 min cold-first-install (postgres initdb + Nest boot)
  - On /health 200: opens http://127.0.0.1:9601/ in default browser
    (via rundll32 url.dll,FileProtocolHandler — HTA's window.open
    spawns a child HTA window, which is the wrong behavior)
  - On 5 min timeout: shows a "check supervisor.log" hint and stays
    open so the operator can read it; user closes via [X]

  HTA = HTML Application. mshta.exe is built into Windows since XP and
  is the only zero-dep way to show a styled progress dialog from a
  service-launching script. Equivalent in PowerShell would require
  WPF + ExecutionPolicy fight, which is worse.
-->
<html>
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>TeleHubX 启动中</title>
  <hta:application
    applicationName="TeleHubXLoading"
    border="thin"
    caption="yes"
    showInTaskbar="yes"
    singleInstance="yes"
    sysmenu="yes"
    maximizeButton="no"
    minimizeButton="yes"
    contextMenu="no"
    selection="no"
    scroll="no"
    innerBorder="no"
    icon="../assets/telehubx.ico"
    windowState="normal"
  />
  <style type="text/css">
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      background: #ffffff;
      color: #262626;
      -ms-user-select: none;
      user-select: none;
    }
    .wrap {
      padding: 24px 28px;
      box-sizing: border-box;
      width: 100%;
      height: 100%;
    }
    .header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }
    .spinner {
      width: 28px;
      height: 28px;
      border: 3px solid #e6f4ff;
      border-top-color: #1677ff;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      flex-shrink: 0;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    h1 {
      font-size: 16px;
      font-weight: 600;
      margin: 0;
      color: #1677ff;
    }
    .subtitle {
      font-size: 12px;
      color: #8c8c8c;
      margin: 0 0 16px 0;
      line-height: 1.5;
    }
    .status {
      font-size: 13px;
      color: #595959;
      padding: 10px 12px;
      background: #f5f5f5;
      border-radius: 4px;
      border-left: 3px solid #1677ff;
      line-height: 1.5;
      word-break: break-all;
    }
    .status.error {
      background: #fff2f0;
      border-left-color: #ff4d4f;
      color: #5c0011;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div class="spinner" id="spin"></div>
      <h1>TeleHubX 正在启动</h1>
    </div>
    <p class="subtitle">首次启动需要 2-3 分钟初始化数据库，请耐心等待。<br/>启动完成后会自动打开浏览器。</p>
    <div class="status" id="status">正在唤醒服务...</div>
  </div>

  <script type="text/javascript">
    var startTime = new Date().getTime();
    var TIMEOUT_MS = 300000;          // 5 min
    var POLL_INTERVAL_MS = 2000;
    var statusEl, spinEl;

    function getEl(id) { return document.getElementById(id); }
    function elapsedSec() { return Math.floor((new Date().getTime() - startTime) / 1000); }

    function statusFor(sec) {
      if (sec < 5)   return '正在唤醒服务...（' + sec + 's）';
      if (sec < 30)  return '正在初始化数据库...（' + sec + 's）';
      if (sec < 90)  return '数据库就绪，启动后端服务...（' + sec + 's）';
      if (sec < 180) return '后端启动中（首次安装较慢）...（' + sec + 's）';
      return '收尾中（仍在启动，再等一会）...（' + sec + 's）';
    }

    function openInDefaultBrowser(url) {
      try {
        var sh = new ActiveXObject('WScript.Shell');
        sh.Run('rundll32.exe url.dll,FileProtocolHandler ' + url, 1, false);
      } catch (e) { /* ignore — user can navigate manually */ }
    }

    function onHealthy() {
      statusEl.innerText = '启动完成，正在打开浏览器...';
      openInDefaultBrowser('http://127.0.0.1:9601/');
      // 给浏览器一点时间起来再关窗
      window.setTimeout(function() {
        try { window.close(); } catch (e) { /* ignore */ }
      }, 1500);
    }

    function onTimeout() {
      spinEl.style.display = 'none';
      statusEl.className = 'status error';
      statusEl.innerHTML =
        '启动超时（5 分钟未响应）。<br/>' +
        '请检查日志：%ProgramData%\\TeleHubX\\data\\logs\\supervisor.log<br/>' +
        '或运行桌面「TeleHubX Debug」快捷方式查看实时状态。';
    }

    function checkHealth() {
      var sec = elapsedSec();
      if (sec * 1000 > TIMEOUT_MS) { onTimeout(); return; }
      statusEl.innerText = statusFor(sec);

      var xhr;
      try { xhr = new ActiveXObject('Microsoft.XMLHTTP'); }
      catch (e1) {
        try { xhr = new XMLHttpRequest(); } catch (e2) { /* should not happen */ }
      }
      if (!xhr) { window.setTimeout(checkHealth, POLL_INTERVAL_MS); return; }

      xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        if (xhr.status === 200) { onHealthy(); return; }
        window.setTimeout(checkHealth, POLL_INTERVAL_MS);
      };
      try {
        xhr.open('GET', 'http://127.0.0.1:9800/health', true);
        xhr.send();
      } catch (e) {
        window.setTimeout(checkHealth, POLL_INTERVAL_MS);
      }
    }

    window.onload = function() {
      statusEl = getEl('status');
      spinEl = getEl('spin');
      // Resize to a reasonable splash size (HTA defaults to full screen)
      try { window.resizeTo(420, 220); } catch (e) { /* ignore */ }
      try { window.moveTo(
        Math.max(0, (screen.availWidth - 420) / 2),
        Math.max(0, (screen.availHeight - 220) / 2)
      ); } catch (e) { /* ignore */ }
      window.setTimeout(checkHealth, 800);
    };
  </script>
</body>
</html>
