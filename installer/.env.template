# =============================================================================
# TeleHubX 安装包内置环境变量 (PUBLIC — 可随安装包分发)
# =============================================================================
#
# 本文件由 installer build 脚本拷贝到 %APPDATA%\TeleHubX\.env
# 客户首次启动前，supervisor 会确保该文件存在；如已存在则保留客户已修改值。
#
# !! 绝对禁止 !! 在本文件加入以下任何变量（构建期 secret-scan 会失败）：
#   ADMIN_TOKEN / LICENSE_ADMIN_TOKEN / LICENSE_PEPPER
#   AGENT_TOKEN_SECRET / AGENT_TOKEN
#   USER_PASSWORD_PEPPER
#   JWT_SECRET / SESSION_ENCRYPTION_KEY
#   CLOUDFLARE_API_TOKEN
#   *_PRIVATE_KEY / *.pem 内容
#
# 这些 secret 由 license server 在 /licenses/activate 响应中动态派发，
# 本地以 AES-GCM 加密保存到 %APPDATA%\TeleHubX\data\agent-token.bin。
# =============================================================================

NODE_ENV=production

# 数据目录（用户可写）
# 安装器会展开 %APPDATA% → C:\Users\<user>\AppData\Roaming
TELEHUBX_DATA_DIR=%ProgramData%\TeleHubX\data

# License 中心
LICENSE_SERVER_URL=https://telehubx-license.starbright-solutions.com
LICENSE_VERIFY_INTERVAL_MS=1800000
LICENSE_HEARTBEAT_INTERVAL_MS=300000
LICENSE_GRACE_PERIOD_MS=86400000
LICENSE_VERIFY_HARD_THRESHOLD=8

# 服务端口（本机 loopback，无需对外）
APP_PORT=9800
DASHBOARD_PORT=9601

# Postgres Portable (随安装包分发, supervisor 启动)
PG_HOST=127.0.0.1
PG_PORT=5436
PG_USER=telehubx
PG_PASSWORD=local-only-not-secret
PG_DATABASE=telehubx
DB_HOST=127.0.0.1
DB_PORT=5436
DB_USER=telehubx
DB_PASSWORD=local-only-not-secret
DB_NAME=telehubx
TYPEORM_SYNC=true

# Redis-for-Windows (tporadowski/redis, BSD-3-Clause) (Redis-compatible, 随安装包分发, supervisor 启动)
REDIS_HOST=127.0.0.1
REDIS_PORT=6386

# Telegram API (共享池 — Phase 6 SaaS 化后改为每租户独立 api_id)
# 注意：api_id / api_hash 不算 server-side secret，TG 客户端需要才能连
TG_API_ID=
TG_API_HASH=
