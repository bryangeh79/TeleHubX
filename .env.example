NODE_ENV=development
APP_PORT=9600
DB_HOST=localhost
DB_PORT=5432
DB_USER=telehubx
DB_PASSWORD=telehubx
DB_NAME=telehubx
# TypeORM 自动同步 schema (entity 改 → DB 自动 ALTER/CREATE).
# 仅 dev 推荐, 默认 false. 生产环境必须保持 false 或不设, schema 演进走
# pnpm typeorm migration:run -- -d src/database/data-source.ts
TYPEORM_SYNC=true
REDIS_HOST=localhost
REDIS_PORT=6379
# CORS 白名单 (Codex round-11 #6) — 生产环境必须设, 用逗号分隔多个 origin
# dev 留空时默认全开方便本地; prod 留空将禁止所有跨域
# CORS_ORIGINS=https://app.telehubx.com,https://admin.telehubx.com
