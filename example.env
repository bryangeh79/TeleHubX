# TeleHubX Environment Configuration
# Copy this to .env and adjust for your environment

# Application
NODE_ENV=development
APP_PORT=9600

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=telehubx
PG_PASSWORD=telehubx_pass
PG_DATABASE=telehubx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (for future auth)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# License Server
LICENSE_SERVER_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
