{
  "name": "telehubx",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Multi-Account Automation SaaS Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @telehubx/server dev",
    "dev:agent": "pnpm --filter @telehubx/agent dev",
    "dev:dashboard": "pnpm --filter @telehubx/dashboard dev",
    "build:server": "pnpm --filter @telehubx/server build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
